<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      全链路追踪：OpenTelemetry + Jaeger
      - 主 appender 使用 opentelemetry-logback-mdc-1.0 的 OpenTelemetryAppender 包装，
        把当前 trace_id / span_id 自动写入 MDC（key 约定为 trace_id / span_id）。
      - 替换之前的 brave-context-slf4j 方案。
    -->
    <appender name="OTEL_CONSOLE" class="io.opentelemetry.instrumentation.logback.mdc.v1_0.OpenTelemetryAppender">
        <appender-ref ref="CONSOLE_BASE"/>
    </appender>

    <appender name="CONSOLE_BASE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] [trace_id=%X{trace_id:-} span_id=%X{span_id:-}] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="OTEL_CONSOLE"/>
    </root>
</configuration>