<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gaia</groupId>
        <artifactId>gaia</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>gaia-server</artifactId>
    <name>gaia-server</name>
    <description>服务进程：Dubbo Provider 承载方（entity / mapper / service / config）</description>

    <dependencies>
        <dependency>
            <groupId>com.gaia</groupId>
            <artifactId>gaia-common</artifactId>
        </dependency>
        <!-- DDD 落地：gaia-server 作为应用层，仅依赖领域层（不直接依赖 infra） -->
        <dependency>
            <groupId>com.gaia</groupId>
            <artifactId>gaia-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gaia</groupId>
            <artifactId>gaia-api</artifactId>
        </dependency>

        <!-- Dubbo（Zookeeper 注册中心，dubbo-kubernetes 仅 K8s 注册模式需要） -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
        </dependency>
        <!-- Dubbo 与 ZK 通信的 Curator 客户端封装 -->
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-recipes</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-x-discovery</artifactId>
        </dependency>

        <!-- Web（用于暴露 actuator） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 监控 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!--
          全链路追踪：OpenTelemetry + Jaeger
          - micrometer-tracing-bridge-otel：让 Spring Boot 内置 Observation API（HTTP 入口 / JDBC / Redis）
            产出的 span 通过 OTel 上报。
          - opentelemetry-exporter-otlp：通过 OTLP/HTTP 把 trace 发到 Jaeger（默认 4318）。
          - opentelemetry-logback-mdc-1.0：把 trace_id / span_id 注入 logback MDC，替换原 brave-context-slf4j。
          Dubbo 3.2 没有官方 OTLP starter，移除原 brave-zipkin starter；
          RPC 上下文通过全局 W3C propagator 传播。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-mdc-1.0</artifactId>
        </dependency>
        <!--
          JDBC Observation：自动为 JDBC 连接获取 / SQL 执行产出 Observation，
          经 micrometer-tracing-bridge-otel 桥接为 OTel span（替换自研 MybatisSqlObservationInterceptor）。
        -->
        <dependency>
            <groupId>net.ttddyy.observation</groupId>
            <artifactId>datasource-micrometer-spring-boot</artifactId>
        </dependency>

        <!-- MyBatis-Plus + MySQL -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!--
          Spring Data Redis + Lettuce（自带 Micrometer Observation tracing，
          由 micrometer-tracing-bridge-otel 桥接到 OpenTelemetry 后，
          Spring Boot 3 自动为每条 Redis 命令产出 OTel span，业务代码无需改动）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--
          Lettuce 连接池基于 Apache Commons Pool 2 实现，
          启用 spring.data.redis.lettuce.pool.* 必须显式引入该依赖。
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- JDBC（@Transactional 等） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 覆盖父 pom pluginManagement 中的 skip=true -->
                    <skip>false</skip>
                    <!--
                      默认 jvmArguments 仅含 add-opens（避免 JDK 17 反射限制）。
                      完整启动参数（profile / dubbo / OTEL_EXPORTER_OTLP_TRACES_ENDPOINT 等）
                      由根 pom 的 dev-server profile 注入：
                        mvn spring-boot:run -P dev-server
                    -->
                    <mainClass>${spring-boot.run.mainClass}</mainClass>
                    <jvmArguments>${spring-boot.jvmArguments}</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
