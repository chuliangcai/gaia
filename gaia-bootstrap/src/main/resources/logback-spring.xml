<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      全链路追踪：OpenTelemetry + OTLP（对接 grafana/otel-lgtm / Jaeger 等 OTLP 后端）
      - 主 appender 使用 opentelemetry-logback-mdc-1.0 的 OpenTelemetryAppender 包装，
        把当前 trace_id / span_id 自动写入 MDC（key 约定为 trace_id / span_id）。
      - 替换之前的 brave-context-slf4j 方案。
    -->
    <property name="LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} [%thread] [trace_id=%X{trace_id:-} span_id=%X{span_id:-}] %-5level %logger{36} - %msg%n"/>
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <!-- spring.application.name 在 logback 初始化时尚不可用，这里写死默认值；可用 LOG_FILE 环境变量覆盖 -->
    <property name="LOG_FILE" value="${LOG_FILE:-gaia-server}"/>

    <appender name="OTEL_CONSOLE" class="io.opentelemetry.instrumentation.logback.mdc.v1_0.OpenTelemetryAppender">
        <appender-ref ref="CONSOLE_BASE"/>
    </appender>

    <appender name="CONSOLE_BASE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
      文件输出：${LOG_PATH}/${LOG_FILE}.log，默认 logs/gaia-server.log。
      通过环境变量 LOG_PATH / LOG_FILE 覆盖；按 50MB / 天滚动，保留 7 天、上限 1GB。
      用 OTEL wrapper 包一层，保证 trace_id / span_id 写入 MDC。
    -->
    <appender name="OTEL_FILE" class="io.opentelemetry.instrumentation.logback.mdc.v1_0.OpenTelemetryAppender">
        <appender-ref ref="FILE_BASE"/>
    </appender>

    <appender name="FILE_BASE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${LOG_FILE}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="OTEL_CONSOLE"/>
        <appender-ref ref="OTEL_FILE"/>
    </root>
</configuration>
