<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gaia</groupId>
        <artifactId>gaia</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>gaia-gateway</artifactId>
    <name>gaia-gateway</name>
    <description>统一 HTTP 网关</description>

    <dependencies>
        <dependency>
            <groupId>com.gaia</groupId>
            <artifactId>gaia-common</artifactId>
        </dependency>

        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Dubbo -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-kubernetes</artifactId>
        </dependency>

        <!-- 监控 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Micrometer Prometheus -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Zipkin / Brave：把 traceId 写入 MDC（与 Dubbo starter 共用 Brave 注册路径） -->
        <dependency>
            <groupId>io.zipkin.brave</groupId>
            <artifactId>brave-context-slf4j</artifactId>
        </dependency>
        <!-- Micrometer Observation → Brave 桥：让 Spring Boot HTTP 入口自动建 Brave span -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <!-- Dubbo 官方 Brave/Zipkin 集成：装配 Brave Tracer + Zipkin reporter + Dubbo TracingFilter -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-tracing-brave-zipkin-starter</artifactId>
        </dependency>

        <!-- 业务模块 API（消费服务） -->
        <dependency>
            <groupId>com.gaia</groupId>
            <artifactId>gaia-api</artifactId>
        </dependency>

        <!-- API 文档（Springdoc OpenAPI 3 + Swagger UI） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 覆盖父 pom pluginManagement 中的 skip=true -->
                    <skip>false</skip>
                    <!--
                      默认 jvmArguments 仅含 add-opens（避免 JDK 17 反射限制）。
                      完整启动参数（profile / zipkin.endpoint 等）
                      由根 pom 的 dev-gateway profile 注入：
                        mvn spring-boot:run -P dev-gateway
                    -->
                    <mainClass>${spring-boot.run.mainClass}</mainClass>
                    <jvmArguments>${spring-boot.jvmArguments}</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>