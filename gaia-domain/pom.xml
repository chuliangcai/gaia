<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gaia</groupId>
        <artifactId>gaia</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>gaia-domain</artifactId>
    <name>gaia-domain</name>
    <description>Gaia 领域层：领域模型、Repository 抽象、领域服务。允许引入 Spring（context/tx/data-redis）以承载充血模型所需的组件注解，但不允许依赖 MyBatis-Plus / Dubbo 等基础设施。</description>

    <dependencies>
        <dependency>
            <groupId>com.gaia</groupId>
            <artifactId>gaia-common</artifactId>
        </dependency>

        <!-- RPC 契约：AbilityMetaService / AbilityDescriptor 由 gaia-api 暴露，domain 提供实现 -->
        <dependency>
            <groupId>com.gaia</groupId>
            <artifactId>gaia-api</artifactId>
        </dependency>

        <!-- Spring 注解支持：@Component / @Service / @Scheduled / @Transactional -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>

        <!-- Redis（RedisLock 强依赖 StringRedisTemplate） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- 测试：JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
