<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gaia</groupId>
    <artifactId>gaia</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>gaia</name>
    <description>Gaia C端互动平台父工程</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <modules>
        <module>gaia-common</module>
        <module>gaia-api</module>
        <module>gaia-domain</module>
        <module>gaia-server</module>
        <module>gaia-infra</module>
        <module>gaia-gateway</module>
        <module>gaia-backend</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dubbo 3.2.9：与 SB 3.2.5 配套；Dubbo 3.3+ 与 SB 3.5 兼容性边界未达成本工程预期，保留 3.2.9 -->
        <dubbo.version>3.2.9</dubbo.version>
        <dubbo-triple.version>3.2.9</dubbo-triple.version>
        <!-- MyBatis-Plus 3.5.7：与 SB 3.2.5 配套 -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <mysql.version>8.0.33</mysql.version>
        <lombok.version>1.18.32</lombok.version>

        <!--
          全链路追踪：OpenTelemetry + Jaeger（OTLP/HTTP）。
          与 Spring Boot 3.2.5 配套：
            - micrometer-tracing 1.2.5
            - opentelemetry 1.31.0
            - opentelemetry-instrumentation 2.1.0-alpha（含 opentelemetry-logback-mdc-1.0）
          Eclipse m2e 解析依赖时不会回退到 SB BOM，因此在此显式锁定。
        -->
        <micrometer-tracing.version>1.2.5</micrometer-tracing.version>
        <opentelemetry.version>1.31.0</opentelemetry.version>
        <opentelemetry-instrumentation.version>2.1.0-alpha</opentelemetry-instrumentation.version>

        <!-- OTLP 默认端点：Jaeger 原生 OTLP/HTTP，端口 4318；运行时由 OTEL_EXPORTER_OTLP_TRACES_ENDPOINT 覆盖 -->
        <otel.exporter.otlp.traces.endpoint>http://127.0.0.1:4318/v1/traces</otel.exporter.otlp.traces.endpoint>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM 由 parent 提供 -->
            <!-- 公共模块 -->
            <dependency>
                <groupId>com.gaia</groupId>
                <artifactId>gaia-common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Dubbo -->
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-spring-boot-starter</artifactId>
                <version>${dubbo.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo</artifactId>
                <version>${dubbo.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-kubernetes</artifactId>
                <version>${dubbo.version}</version>
            </dependency>
            <!-- Dubbo 与 ZK 通信的 Curator 客户端封装（dubbo-spring-boot-starter 不会传递依赖 curator） -->
            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-framework</artifactId>
                <version>5.1.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-recipes</artifactId>
                <version>5.1.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-x-discovery</artifactId>
                <version>5.1.0</version>
            </dependency>

            <!-- MyBatis-Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- MySQL -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <!-- Spring Data Redis / Lettuce 版本由 Spring Boot BOM 管理，无需显式声明 -->

            <!--
              Micrometer / OpenTelemetry / Tracing 等版本由 spring-boot-starter-parent → spring-boot-dependencies BOM
              统一管理，子模块直接无版本依赖即可。
              （不要在本 dependencyManagement 重复声明这些条目，否则会覆盖 BOM 的版本解析，导致 'version is missing'。）
            -->

            <!--
              OpenTelemetry OTLP Exporter：默认将 trace span 发送至 Jaeger（原生支持 OTLP/HTTP，端口 4318）。
              端点由 OTEL_EXPORTER_OTLP_TRACES_ENDPOINT 环境变量或 application.yml otlp.traces.endpoint 覆盖。
            -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-exporter-otlp</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <!--
              Logback MDC 桥（1.0）：在每条日志注入 trace_id / span_id 到 MDC，
              key 名约定为 trace_id / span_id（区别于之前 brave 的 traceId/spanId）。
            -->
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-logback-mdc-1.0</artifactId>
                <version>${opentelemetry-instrumentation.version}</version>
            </dependency>
            <!--
              Micrometer Tracing → OpenTelemetry 桥：让 Spring Boot 内置的 Observation API（HTTP 入口、
              JDBC / Redis 等）产出的 span 通过 OTel 上报。
            -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-tracing-bridge-otel</artifactId>
                <version>${micrometer-tracing.version}</version>
            </dependency>

            <!--
              Datasource Micrometer（JDBC Observation 替代品）：
              Spring Boot 3.5+ 可直接通过该 starter 为 JDBC 连接获取 / SQL 执行
              产出 Observation，并由 micrometer-tracing-bridge-otel 桥接为 OTel span，
              替换自研 MybatisSqlObservationInterceptor。
              该依赖不在 Spring Boot BOM 中，需要显式声明版本。
            -->
            <dependency>
                <groupId>net.ttddyy.observation</groupId>
                <artifactId>datasource-micrometer-spring-boot</artifactId>
                <version>1.0.6</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- 模块内部依赖 -->
            <dependency>
                <groupId>com.gaia</groupId>
                <artifactId>gaia-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gaia</groupId>
                <artifactId>gaia-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gaia</groupId>
                <artifactId>gaia-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gaia</groupId>
                <artifactId>gaia-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 公共依赖：所有子模块都引入 Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <!--
                  spring-boot-maven-plugin 在父 pom（packaging=pom）上默认会执行并找不到
                  main class。在 pluginManagement 里配置 <skip>true</skip>，让父模块
                  执行 spring-boot:run 时直接跳过；同时子模块在自身 <build> 中显式声明
                  并用 <skip>false</skip> 覆盖即可启动。
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!--
      Maven profiles: 通过 -P<id> 激活，把 mainClass / jvmArguments 等
      作为 Maven 属性注入；子模块 pom 通过 ${spring-boot.run.mainClass} 与
      ${spring-boot.jvmArguments} 占位符引用，从而让 spring-boot-maven-plugin
      在子模块上正确启动。
      用法:
        mvn spring-boot:run -pl gaia-server -am -P dev-server
        mvn spring-boot:run -pl gaia-gateway -am -P dev-gateway
        mvn spring-boot:run -pl gaia-backend -am -P dev-backend
      全链路追踪：OpenTelemetry + Jaeger（OTLP/HTTP，不再依赖 javaagent）
        - 端点通过 -DOTEL_EXPORTER_OTLP_TRACES_ENDPOINT=... 注入
          （application.yml 中以 ${OTEL_EXPORTER_OTLP_TRACES_ENDPOINT:...} 占位）
        - 默认指向 Jaeger（http://jaeger:4318/v1/traces 或本地 127.0.0.1:4318）
        - 采样率由 management.tracing.sampling.probability 配置（默认 1.0）
    -->
    <profiles>
        <!-- 公共：仅含 add-opens（避免 JDK 17 反射限制），其它属性可被子 profile 覆盖 -->
        <profile>
            <id>dev-base</id>
            <properties>
                <jvm.add-opens>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.math=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED</jvm.add-opens>
            </properties>
        </profile>

        <!-- gaia-server: dev 参数 + 关闭 Dubbo 注册推送 -->
        <profile>
            <id>dev-server</id>
            <properties>
                <spring-boot.run.mainClass>com.gaia.server.GaiaServerApplication</spring-boot.run.mainClass>
                <spring.profiles.active>dev</spring.profiles.active>
                <otel.exporter.otlp.traces.endpoint>http://127.0.0.1:4318/v1/traces</otel.exporter.otlp.traces.endpoint>
                <dubbo.registry.register>false</dubbo.registry.register>
                <jvm.add-opens>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.math=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED</jvm.add-opens>
                <spring-boot.jvmArguments>${jvm.add-opens} -Dspring.profiles.active=${spring.profiles.active} -Ddubbo.registry.register=${dubbo.registry.register} -DOTEL_EXPORTER_OTLP_TRACES_ENDPOINT=${otel.exporter.otlp.traces.endpoint} -DMYSQL_PASSWORD=12345</spring-boot.jvmArguments>
            </properties>
        </profile>

        <!-- gaia-gateway: dev 参数 -->
        <profile>
            <id>dev-gateway</id>
            <properties>
                <spring-boot.run.mainClass>com.gaia.gateway.GaiaGatewayApplication</spring-boot.run.mainClass>
                <spring.profiles.active>dev</spring.profiles.active>
                <otel.exporter.otlp.traces.endpoint>http://127.0.0.1:4318/v1/traces</otel.exporter.otlp.traces.endpoint>
                <jvm.add-opens>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.math=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED</jvm.add-opens>
                <spring-boot.jvmArguments>${jvm.add-opens} -Dspring.profiles.active=${spring.profiles.active} -DOTEL_EXPORTER_OTLP_TRACES_ENDPOINT=${otel.exporter.otlp.traces.endpoint}</spring-boot.jvmArguments>
            </properties>
        </profile>

        <!-- gaia-backend: dev 参数，独立端口 8088，关闭 Dubbo 注册推送 -->
        <profile>
            <id>dev-backend</id>
            <properties>
                <spring-boot.run.mainClass>com.gaia.backend.GaiaBackendApplication</spring-boot.run.mainClass>
                <spring.profiles.active>dev</spring.profiles.active>
                <otel.exporter.otlp.traces.endpoint>http://127.0.0.1:4318/v1/traces</otel.exporter.otlp.traces.endpoint>
                <dubbo.registry.register>false</dubbo.registry.register>
                <jvm.add-opens>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.math=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED</jvm.add-opens>
                <spring-boot.jvmArguments>${jvm.add-opens} -Dspring.profiles.active=${spring.profiles.active} -Ddubbo.registry.register=${dubbo.registry.register} -DOTEL_EXPORTER_OTLP_TRACES_ENDPOINT=${otel.exporter.otlp.traces.endpoint} -DMYSQL_PASSWORD=12345</spring-boot.jvmArguments>
            </properties>
        </profile>
    </profiles>
</project>