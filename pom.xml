<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gaia</groupId>
    <artifactId>gaia</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>gaia</name>
    <description>Gaia C端互动平台父工程</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <modules>
        <module>gaia-common</module>
        <module>gaia-api</module>
        <module>gaia-gateway</module>
        <module>gaia-server</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <dubbo.version>3.2.9</dubbo.version>
        <dubbo-triple.version>3.2.9</dubbo-triple.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <mysql.version>8.0.33</mysql.version>
        <jedis.version>5.1.2</jedis.version>
        <micrometer.version>1.12.5</micrometer.version>
        <lombok.version>1.18.32</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM 由 parent 提供 -->
            <!-- 公共模块 -->
            <dependency>
                <groupId>com.gaia</groupId>
                <artifactId>gaia-common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Dubbo -->
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-spring-boot-starter</artifactId>
                <version>${dubbo.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo</artifactId>
                <version>${dubbo.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-kubernetes</artifactId>
                <version>${dubbo.version}</version>
            </dependency>

            <!-- MyBatis-Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- MySQL -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <!-- Jedis -->
            <dependency>
                <groupId>redis.clients</groupId>
                <artifactId>jedis</artifactId>
                <version>${jedis.version}</version>
            </dependency>

            <!-- Micrometer Prometheus -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-registry-prometheus</artifactId>
                <version>${micrometer.version}</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- 模块内部依赖 -->
            <dependency>
                <groupId>com.gaia</groupId>
                <artifactId>gaia-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gaia</groupId>
                <artifactId>gaia-server</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 公共依赖：所有子模块都引入 Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <!--
                  spring-boot-maven-plugin 在父 pom（packaging=pom）上默认会执行并找不到
                  main class。在 pluginManagement 里配置 <skip>true</skip>，让父模块
                  执行 spring-boot:run 时直接跳过；同时子模块在自身 <build> 中显式声明
                  并用 <skip>false</skip> 覆盖即可启动。
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!--
      Maven profiles: 通过 -P<id> 激活，把 mainClass / jvmArguments 等
      作为 Maven 属性注入；子模块 pom 通过 ${spring-boot.run.mainClass} 与
      ${spring-boot.jvmArguments} 占位符引用，从而让 spring-boot-maven-plugin
      在子模块上正确启动。
      用法:
        mvn spring-boot:run -pl gaia-server -am -P dev-server
        mvn spring-boot:run -pl gaia-gateway -am -P dev-gateway
    -->
    <profiles>
        <!-- 公共：仅含 add-opens（避免 JDK 17 反射限制），其它属性可被子 profile 覆盖 -->
        <profile>
            <id>dev-base</id>
            <properties>
                <jvm.add-opens>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.math=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED</jvm.add-opens>
            </properties>
        </profile>

        <!-- gaia-server: dev 参数 + 关闭 Dubbo 注册推送 -->
        <profile>
            <id>dev-server</id>
            <properties>
                <spring-boot.run.mainClass>com.gaia.server.GaiaServerApplication</spring-boot.run.mainClass>
                <spring.profiles.active>dev</spring.profiles.active>
                <skywalking.agent.name>gaia-server</skywalking.agent.name>
                <skywalking.agent.path>/Users/apple001/data/docker-compose/skywalking-agent/skywalking-agent.jar</skywalking.agent.path>
                <skywalking.agent.collector>127.0.0.1:11800</skywalking.agent.collector>
                <dubbo.registry.register>false</dubbo.registry.register>
                <jvm.add-opens>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.math=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED</jvm.add-opens>
                <spring-boot.jvmArguments>${jvm.add-opens} -javaagent:${skywalking.agent.path} -DSW_AGENT_NAME=${skywalking.agent.name} -DSW_AGENT_COLLECTOR=${skywalking.agent.collector} -Dspring.profiles.active=${spring.profiles.active} -Ddubbo.registry.register=${dubbo.registry.register} -DMYSQL_PASSWORD=12345</spring-boot.jvmArguments>
            </properties>
        </profile>

        <!-- gaia-gateway: dev 参数 -->
        <profile>
            <id>dev-gateway</id>
            <properties>
                <spring-boot.run.mainClass>com.gaia.gateway.GaiaGatewayApplication</spring-boot.run.mainClass>
                <spring.profiles.active>dev</spring.profiles.active>
                <skywalking.agent.name>gaia-gateway</skywalking.agent.name>
                <skywalking.agent.path>/Users/apple001/data/docker-compose/skywalking-agent/skywalking-agent.jar</skywalking.agent.path>
                <skywalking.agent.collector>127.0.0.1:11800</skywalking.agent.collector>
                <jvm.add-opens>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.math=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED</jvm.add-opens>
                <spring-boot.jvmArguments>${jvm.add-opens} -javaagent:${skywalking.agent.path} -DSW_AGENT_NAME=${skywalking.agent.name} -DSW_AGENT_COLLECTOR=${skywalking.agent.collector} -Dspring.profiles.active=${spring.profiles.active}</spring-boot.jvmArguments>
            </properties>
        </profile>
    </profiles>
</project>